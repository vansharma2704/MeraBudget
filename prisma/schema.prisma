// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

model User {
  id            String          @id @default(uuid())
  clerkUserid   String          @unique
  email         String          @unique
  name          String?
  imageUrl      String?
  transactions  Transaction[]
  accounts      Account[]
  budgets       Budget[]
  goals         SavingsGoal[]
  bills         BillReminder[]
  subscriptions Subscription[]
  splits        SplitExpense[]
  splitGroups   SplitGroup[]
  achievements  Achievement[]
  streak        UserStreak?
  preferences   UserPreferences?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("users")
}

model Account {
  id           String        @id @default(uuid())
  name         String
  type         AccountType
  balance      Decimal       @default(0)
  isDefault    Boolean       @default(false)
  userId       String
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([userId])
  @@map("accounts")
}

enum AccountType {
  CURRENT
  SAVINGS
}

model Transaction {
  id                String            @id @default(uuid())
  type              TransactionType
  amount            Decimal
  description       String?
  date              DateTime
  category          String
  receiptUrl        String?
  keywords          String[]          @default([]) // e.g. ["upi", "swiggy", "food delivery"]
  isRecurring       Boolean           @default(false)
  recurringInterval RecurringInterval?
  nextRecurringDate DateTime?
  lastProcessed     DateTime?
  status            TransactionStatus @default(COMPLETED)
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  accountId         String
  account           Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([userId])
  @@index([accountId])
  @@index([userId, date]) // composite for date-range queries on dashboard
  @@map("transactions")
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

enum RecurringInterval {
  DAILY
  WEEKLY
  MONTHLY
  YEARLY
}

model Budget {
  id            String    @id @default(uuid())
  amount        Decimal
  lastAlertSent DateTime?
  userID        String    @unique
  user          User      @relation(fields: [userID], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userID])
  @@map("budgets")
}

model SavingsGoal {
  id                  String   @id @default(uuid())
  name                String
  targetAmount        Decimal
  currentAmount       Decimal  @default(0)
  monthlyContribution Decimal?
  icon                String?
  deadline            DateTime?
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([userId])
  @@map("savings_goals")
}

model BillReminder {
  id        String            @id @default(uuid())
  name      String
  amount    Decimal
  dueDate   DateTime
  frequency RecurringInterval
  status    String            @default("PENDING") // PENDING, PAID
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  @@index([userId])
  @@map("bill_reminders")
}

model Subscription {
  id           String            @id @default(uuid())
  name         String
  amount       Decimal
  frequency    RecurringInterval @default(MONTHLY)
  category     String?
  nextBilling  DateTime
  userId       String
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([userId])
  @@map("subscriptions")
}

model SplitExpense {
  id           String   @id @default(uuid())
  description  String
  totalAmount  Decimal
  participants Json     // Array of { name: string, share: number }
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("split_expenses")
}

model Achievement {
  id           String   @id @default(uuid())
  type         String   // e.g., "DISCIPLINED_SPENDER", "SAVINGS_MASTER"
  name         String
  description  String
  icon         String?
  unlockedAt   DateTime @default(now())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("achievements")
}

model UserStreak {
  id            String   @id @default(uuid())
  currentStreak Int      @default(0)
  longestStreak Int      @default(0)
  lastActivity  DateTime @default(now())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_streaks")
}

model UserPreferences {
  id                String   @id @default(uuid())
  userId            String   @unique
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  monthlyIncome     Decimal?
  budgetAllocations Json?    // Object of { category: percentage }
  theme             String   @default("dark")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("user_preferences")
}


// ── Splitwise-style groups ──
// Members are plain names owned by the user (they don't need accounts). Amounts are rupees.
model SplitGroup {
  id          String            @id @default(uuid())
  name        String
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  members     GroupMember[]
  expenses    GroupExpense[]
  settlements GroupSettlement[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId])
  @@map("split_groups")
}

model GroupMember {
  id              String            @id @default(uuid())
  name            String
  isSelf          Boolean           @default(false) // the app user ("You")
  groupId         String
  group           SplitGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  expensesPaid    GroupExpense[]
  settlementsSent GroupSettlement[] @relation("SettlementFrom")
  settlementsGot  GroupSettlement[] @relation("SettlementTo")
  createdAt       DateTime          @default(now())

  @@index([groupId])
  @@map("group_members")
}

model GroupExpense {
  id          String      @id @default(uuid())
  description String
  amount      Decimal
  splitMode   String      @default("equal") // equal | amount | percent | shares
  shares      Json        // [{ memberId, amount }] — amounts add up to `amount`
  date        DateTime    @default(now())
  paidById    String
  paidBy      GroupMember @relation(fields: [paidById], references: [id], onDelete: NoAction)
  groupId     String
  group       SplitGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt   DateTime    @default(now())

  @@index([groupId])
  @@map("group_expenses")
}

// A repayment: `from` paid `to` back
model GroupSettlement {
  id        String      @id @default(uuid())
  amount    Decimal
  date      DateTime    @default(now())
  fromId    String
  from      GroupMember @relation("SettlementFrom", fields: [fromId], references: [id], onDelete: NoAction)
  toId      String
  to        GroupMember @relation("SettlementTo", fields: [toId], references: [id], onDelete: NoAction)
  groupId   String
  group     SplitGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime    @default(now())

  @@index([groupId])
  @@map("group_settlements")
}
